{
    "name": "retrocommit",
    "version": "1.0.0",
    "description": "Fill the gaps in your GitHub contribution graph with backdated commits. Fully configurable, straight from your terminal.",
    "keywords": [
        "github",
        "contributions",
        "contribution-graph",
        "commits",
        "backdate",
        "git",
        "cli",
        "streak",
        "activity",
        "green-squares"
    ],
    "homepage": "https://github.com/abpineda/retrocommit#readme",
    "bugs": {
        "url": "https://github.com/abpineda/retrocommit/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/abpineda/retrocommit.git"
    },
    "license": "MIT",
    "author": "abpineda (https://github.com/abpineda)",
    "type": "module",
    "bin": {
        "retrocommit": "dist/cli.js"
    },
    "files": [
        "dist",
        "schema.json"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "start": "node dist/cli.js",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "schema": "node scripts/generate-schema.ts",
        "prepack": "npm run build"
    },
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@clack/prompts": "^1.8.1",
        "commander": "^15.0.0",
        "picocolors": "^1.1.1",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/node": "^26.6.2",
        "@vitest/coverage-v8": "^5.0.1",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.1"
    }
}
